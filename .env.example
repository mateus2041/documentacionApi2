# Puerto HTTP (predeterminado: 3000)
PORT=3000

# Configure un valor aleatorio y privado antes de ejecutar en un entorno real.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Zona horaria usada para fechas y cierres
ZONA_HORARIA=America/Bogota

# Reglas de negocio (valores predeterminados del código)
MINUTOS_ANULACION=10
MINUTOS_CIERRE_VENTAS=15
APUESTA_MIN_CHANCE=500
APUESTA_MAX_CHANCE=50000
VALOR_BALOTO=5700
DIAS_CADUCIDAD_PREMIO=365
